diff --git a/src/lib_interface/data_manager/base_core_configuration.cpp b/src/lib_interface/data_manager/base_core_configuration.cpp
index 4d65975..c99b015 100644
--- a/src/lib_interface/data_manager/base_core_configuration.cpp
+++ b/src/lib_interface/data_manager/base_core_configuration.cpp
@@ -92,6 +92,25 @@ bool Base_Core_Configuration::LoadCfgFile( CXml& fichierXml, bool verbose_mode)
 			SetConfigInformation(FPROP_TIME_STEP,simuNode->GetProperty("pasdetemps").ToFloat());
 			SetConfigInformation(FPROP_SIMULATION_TIME,simuNode->GetProperty("duree_simulation").ToFloat());
 			SetConfigInformation(IPROP_QUANT_TIMESTEP,(entier)(ceil((*FastGetConfigValue(FPROP_SIMULATION_TIME))/(*FastGetConfigValue(FPROP_TIME_STEP)))));
+			// Surface receivers and cutting planes keep one value per cell per time bin for the whole
+			// run. The bin is the particle time step unless recepteurs_surfaciques_pas_temps asks for
+			// a longer one; it is rounded to a whole number of steps so every step falls in one bin,
+			// and the memory and file size of those receivers divide by that number.
+			{
+				float timeStep=*FastGetConfigValue(FPROP_TIME_STEP);
+				float surfaceStep=timeStep;
+				if(simuNode->IsPropertyExist("recepteurs_surfaciques_pas_temps"))
+					surfaceStep=simuNode->GetProperty("recepteurs_surfaciques_pas_temps").ToFloat();
+				entier ratio=1;
+				if(timeStep>0 && surfaceStep>timeStep)
+					ratio=(entier)floor(surfaceStep/timeStep+0.5f);
+				if(ratio<1)
+					ratio=1;
+				entier nbTimeStep=*FastGetConfigValue(IPROP_QUANT_TIMESTEP);
+				SetConfigInformation(FPROP_SURFACE_RECEIVER_TIME_STEP,timeStep*(float)ratio);
+				SetConfigInformation(IPROP_SURFACE_RECEIVER_STEP_RATIO,ratio);
+				SetConfigInformation(IPROP_QUANT_SURFACE_RECEIVER_TIMESTEP,(entier)((nbTimeStep+ratio-1)/ratio));
+			}
 
 			SetConfigInformation(SPROP_DIRECTIVITY_FOLDER_PATH, simuNode->GetProperty("directivities_directory"));
 
