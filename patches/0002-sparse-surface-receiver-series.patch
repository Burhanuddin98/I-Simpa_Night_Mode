 const double _REF_W0_=pow(10.,-12.);
 
+/**
+ * @brief One cell's or face's energy over the time steps, stored sparse (I-Simpa Night Mode, patch 0002).
+ *
+ * Only the steps that received energy are kept, sorted by step, as (step, energy) pairs; once more than an
+ * eighth of the steps hold energy the series switches to a dense array, which is then the cheaper form.
+ * Adds land on their step in arrival order, so every sum is the dense array's bit for bit. Readers call
+ * get(), never an index. Why: a cutting plane of 110,888 cells over 10,000 steps and 18 bands held 74 GB
+ * as dense arrays, almost all of it zeros, and SPPS aborted while zero-filling it at start-up.
+ */
+class SparseTimeSeries
+{
+public:
+	SparseTimeSeries():nbtimestep(0){}
+	/** Sets the step count. The series is empty (every step 0) and takes no memory until energy arrives. */
+	void resize(uentier _nbtimestep)
+	{
+		nbtimestep=_nbtimestep;
+		steps.clear();values.clear();dense.clear();
+		if(nbtimestep>65535) //A step index must fit uint16_t; a longer run keeps the dense array as before
+			dense.assign(nbtimestep,0);
+	}
+	uentier size() const { return nbtimestep; }
+	bool empty() const { return nbtimestep==0; }
+	/**
+	 * Adds energy at a step. The particle's energy is a double (l_decimal) and the dense array was a float,
+	 * so upstream's `cell += energy` added in double and rounded once; this does the same, bit for bit.
+	 * A step past the count is ignored (the dense array wrote out of bounds there).
+	 */
+	void add(uentier step,double energy)
+	{
+		if(step>=nbtimestep) return;
+		if(!dense.empty()) { dense[step]=(decimal)((double)dense[step]+energy); return; }
+		std::vector<uint16_t>::iterator it=std::lower_bound(steps.begin(),steps.end(),(uint16_t)step);
+		std::size_t at=it-steps.begin();
+		if(it!=steps.end() && *it==step) { values[at]=(decimal)((double)values[at]+energy); return; }
+		if(steps.size()+1>denseThreshold()) { toDense(); dense[step]=(decimal)((double)dense[step]+energy); return; }
+		steps.insert(it,(uint16_t)step);
+		values.insert(values.begin()+at,(decimal)energy);
+	}
+	/** Sets the energy at a step (rounded to the cell's float, as an assignment to the dense array was). */
+	void set(uentier step,double energy)
+	{
+		if(step>=nbtimestep) return;
+		decimal v=(decimal)energy;
+		if(!dense.empty()) { dense[step]=v; return; }
+		std::vector<uint16_t>::iterator it=std::lower_bound(steps.begin(),steps.end(),(uint16_t)step);
+		std::size_t at=it-steps.begin();
+		if(it!=steps.end() && *it==step) { values[at]=v; return; }
+		if(steps.size()+1>denseThreshold()) { toDense(); dense[step]=v; return; }
+		steps.insert(it,(uint16_t)step);
+		values.insert(values.begin()+at,v);
+	}
+	/** The energy at a step; 0 where none arrived. */
+	decimal get(uentier step) const
+	{
+		if(step>=nbtimestep) return 0;
+		if(!dense.empty()) return dense[step];
+		if(steps.empty() || step<steps.front() || step>steps.back()) return 0;
+		std::vector<uint16_t>::const_iterator it=std::lower_bound(steps.begin(),steps.end(),(uint16_t)step);
+		return (it!=steps.end() && *it==step) ? values[it-steps.begin()] : 0;
+	}
+	/** Multiplies every stored energy; a zero stays zero, as in the dense array. */
+	void scale(decimal factor)
+	{
+		for(std::size_t i=0;i<dense.size();i++) dense[i]*=factor;
+		for(std::size_t i=0;i<values.size();i++) values[i]*=factor;
+	}
+	/** Steps holding energy (the dense array counts its non-zeros). */
+	std::size_t count() const
+	{
+		if(dense.empty()) return steps.size();
+		std::size_t n=0;
+		for(std::size_t i=0;i<dense.size();i++) if(dense[i]!=0) n++;
+		return n;
+	}
+private:
+	std::size_t denseThreshold() const { return (std::size_t)nbtimestep/8+1; }
+	void toDense()
+	{
+		dense.assign(nbtimestep,0);
+		for(std::size_t i=0;i<steps.size();i++) dense[steps[i]]=values[i];
+		std::vector<uint16_t>().swap(steps);
+		std::vector<decimal>().swap(values);
+	}
+	uentier nbtimestep;
+	std::vector<uint16_t> steps;
+	std::vector<decimal> values;
+	std::vector<decimal> dense;
+};
+
 
