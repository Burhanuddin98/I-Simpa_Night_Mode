        "description": "One surface-receiver or cutting-plane file, summarised (the values stay in the file; M12 reads\nit with the `.csbin` reader).",
        "properties": {
          "band_hz": {
            "description": "The band; `null` for the `Global` file, **an aggregate of all bands**.",
            "format": "int32",
            "type": [
              "integer",
              "null"
            ]
          },
          "cutting_plane": {
            "type": "boolean"
          },
          "field": {
            "description": "TCR's field; `null` for SPPS.",
            "type": [
              "string",
              "null"
            ]
          },
          "path": {
            "description": "Relative to `solve/`.",
            "type": "string"
          },
          "receivers": {
            "items": {
              "$ref": "#/$defs/SurfaceReceiverSummary"
            },
            "type": "array"
          },
          "record_type": {
            "description": "`recordType` (`docs/formats/csbin.md`).",
            "type": "string"
          },
          "time_step_s": {
            "format": "double",
            "type": "number"
          },
          "time_steps": {
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
