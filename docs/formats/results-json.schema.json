          "global",
          "point_receivers",
          "surfaces",
          "analytic"
        ],
        "type": "object"
      },
      "Theory": {
        "description": "One theory's values in one band of `Main results.gabe`.",
        "properties": {
          "absorption_area_m2": {
            "description": "`A_*`: the equivalent absorption area, m².",
            "format": "double",
            "type": "number"
          },
          "level_db": {
            "description": "`L_*`: the reverberant field's level, dB.",
            "format": "double",
            "type": "number"
          },
          "reverberation_time_s": {
            "description": "`TR_*`: the reverberation time, s.",
            "format": "double",
            "type": "number"
          }
