          "cutting_plane",
          "record_type",
          "time_steps",
          "time_step_s",
          "receivers"
        ],
        "type": "object"
      },
      "TcrGlobal": {
        "description": "TCR's `Global` row: the energetic sum of the band levels, **an aggregate**.",
