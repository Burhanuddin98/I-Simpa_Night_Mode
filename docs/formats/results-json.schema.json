        "description": "A TCR run: its values as TCR computed them, and `core::params`' analytic Sabine and Eyring\ntimes on the same inputs. TCR writes no time series, so there are no per-receiver parameters.",
        "properties": {
          "analytic": {
            "$ref": "#/$defs/AnalyticReport"
          },
          "bands": {
            "items": {
              "$ref": "#/$defs/MainBand"
            },
            "type": "array"
          },
          "global": {
            "$ref": "#/$defs/TcrGlobal"
          },
          "point_receivers": {
            "items": {
