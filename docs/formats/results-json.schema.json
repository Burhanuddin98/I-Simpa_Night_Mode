    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "description": "What `simpa results <run> --json` prints.",
    "properties": {
      "bands_hz": {
        "description": "The computed bands, ascending.",
        "items": {
          "format": "int32",
          "type": "integer"
        },
        "type": "array"
      },
      "results_version": {
        "description": "[`REPORT_VERSION`].",
        "format": "uint32",
        "minimum": 0,
        "type": "integer"
      },
      "run_folder": {
        "description": "The run folder, as given.",
        "type": "string"
      },
      "solver": {
        "$ref": "#/$defs/SolverKind"
      },
      "spps": {
        "anyOf": [
          {
            "$ref": "#/$defs/SppsReport"
          },
          {
            "type": "null"
          }
        ],
        "description": "Present for an SPPS run."
      },
      "started": {
        "description": "`run.json`'s `started`.",
        "type": "string"
      },
      "status": {
        "$ref": "#/$defs/Status",
        "description": "Always OK: any other run is refused."
      },
      "tcr": {
        "anyOf": [
          {
            "$ref": "#/$defs/TcrReport"
          },
          {
            "type": "null"
          }
        ],
        "description": "Present for a TCR run."
      },
      "validated_by_bed": {
        "description": "False until M8's physics bed passes: no number here may be shown to a user.",
        "type": "boolean"
      }
    },
    "required": [
      "results_version",
      "validated_by_bed",
      "run_folder",
      "solver",
      "status",
      "started",
      "bands_hz"
    ],
    "title": "Report",
    "type": "object"
  }
