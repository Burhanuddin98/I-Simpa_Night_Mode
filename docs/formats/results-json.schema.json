            "description": "Always `\"energetic sum of the band levels\"`.",
            "type": "string"
          },
          "eyring_level_db": {
            "format": "double",
            "type": "number"
          },
          "sabine_level_db": {
            "format": "double",
            "type": "number"
          }
        },
        "required": [
          "aggregate",
          "sabine_level_db",
          "eyring_level_db"
        ],
        "type": "object"
      },
