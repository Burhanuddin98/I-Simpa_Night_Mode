// The node --test suites beside the pure modules (PLAN.md 2.4, rule 8), typed with Node's own
// types. The app's tsconfig leaves them out, so browser code never sees Node's globals.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"]
  },
  "include": ["src/**/*.test.ts"],
  "exclude": []
}
