    "allow-run-report",
    "allow-run-data",
    "allow-run-surface-map",
    "allow-run-particles",
    "allow-run-echogram",
    "allow-run-auralize",
    "allow-proj-import",
    "allow-material-library",
    "allow-spectrum-library",
    "allow-solvers-status",
    "allow-spps-gpu-status",
    "allow-app-events",
    "allow-app-quit",
    "allow-export-write"
