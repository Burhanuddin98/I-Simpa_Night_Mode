    "allow-bench-prepare",
    "allow-bench-take",
    "allow-bench-clear",
    "allow-run-events-probe",
    "allow-exact-float-probe",
    "allow-project-new",
    "allow-project-load-text",
    "allow-project-open",
    "allow-project-info",
    "allow-project-json",
    "allow-project-apply",
    "allow-project-undo",
    "allow-project-redo",
    "allow-app-startup",
    "allow-selftest-report",
    "allow-scene-state",
    "allow-scene-new",
    "allow-scene-new-box",
    "allow-scene-open",
    "allow-example-open",
    "allow-model-import",
    "allow-model-repair",
    "allow-model-reimport",
    "allow-mesh-now",
    "allow-project-save",
    "allow-edit-apply",
