{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "I-Simpa Night Mode",
  "version": "0.1.0",
  "identifier": "com.dockyard.nightmode",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "I-Simpa Night Mode",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "backgroundColor": "#09090B",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "freezePrototype": true,
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self'",
        "font-src": "'self'",
        "img-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'",
        "frame-ancestors": "'none'",
        "worker-src": "'none'",
        "media-src": "'none'"
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
